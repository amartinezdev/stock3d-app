# Plantilla de configuración para docker compose.
#
# Cópiala a .env en el servidor y rellena los valores:  cp .env.example .env
# El .env NUNCA se sube a git (está en .gitignore): contiene secretos.

# Dominio desde el que se sirve la app. Con un dominio real, Caddy saca el
# certificado HTTPS solo. Déjalo en localhost para probar el montaje.
DOMINIO=localhost

# Base de datos
POSTGRES_DB=stockdb
DB_USERNAME=stock
DB_PASSWORD=cambia-esto-por-una-contrasena-larga

# Clave con la que se firman los JWT. Mínimo 32 caracteres (lo exige
# HS256) y distinta de la que uses en desarrollo. Para generar una:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios
